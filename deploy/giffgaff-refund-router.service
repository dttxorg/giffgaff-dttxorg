[Unit]
Description=giffgaff public path router
After=network-online.target giffgaff-label.service giffgaff-refund-agent.service
Wants=network-online.target giffgaff-label.service giffgaff-refund-agent.service

[Service]
Type=simple
User=giffgaff
Group=giffgaff
WorkingDirectory=/data/services/giffgaff-refund-agent/current
Environment=HOST=127.0.0.1
Environment=PORT=8000
Environment=LABEL_PORT=8001
Environment=REFUND_PORT=18085
ExecStart=/usr/local/bin/node /data/services/giffgaff-refund-agent/current/deploy/refund-router.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
